{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Community 311 Deployment Configuration",
  "type": "object",
  "required": [
    "cityName",
    "countyName",
    "regionName",
    "appTitle",
    "headerTagline",
    "pageDescription",
    "socialDescription",
    "mapCenter",
    "defaultZoom"
  ],
  "properties": {
    "cityName": { "type": "string", "minLength": 1 },
    "countyName": { "type": "string" },
    "regionName": { "type": "string", "minLength": 1 },
    "appTitle": { "type": "string", "minLength": 1 },
    "headerTagline": { "type": "string" },
    "pageDescription": { "type": "string" },
    "socialDescription": { "type": "string" },
    "mapCenter": {
      "type": "object",
      "required": ["lat", "lng"],
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lng": { "type": "number", "minimum": -180, "maximum": 180 }
      },
      "additionalProperties": false
    },
    "defaultZoom": { "type": "integer", "minimum": 1, "maximum": 20 },
    "analyticsMeasurementId": { "type": "string", "pattern": "^(?:|G-[A-Z0-9]+)$" },
    "reportWebhookUrl": {
      "type": "string",
      "pattern": "^https://discord\\.com/api/webhooks/[0-9]+/[A-Za-z0-9_-]+$"
    },
    "contactEmail": { "type": ["string", "null"], "format": "email" },
    "repositoryUrl": { "type": "string", "format": "uri" },
    "deploymentUrl": { "type": "string", "format": "uri" }
  },
  "additionalProperties": false
}
